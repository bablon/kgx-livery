From: Zander Brown <zbrown@gnome.org>
Date: Wed, 13 Nov 2024 15:14:13 +0000
Subject: settings: a method to resolve KGX_THEME_AUTO

(cherry picked from commit f5752e8ea0f709bf0ce6a6da0da4382618f19c5e)

Origin: upstream, future 48 alpha
---
 src/kgx-settings.c | 36 +++++++++++++++++++++++++++---------
 src/kgx-settings.h |  2 ++
 2 files changed, 29 insertions(+), 9 deletions(-)

diff --git a/src/kgx-settings.c b/src/kgx-settings.c
index c486861..42e0ddc 100644
--- a/src/kgx-settings.c
+++ b/src/kgx-settings.c
@@ -638,15 +638,8 @@ kgx_settings_get_resolved_theme (KgxSettings *self)
 
   g_return_val_if_fail (KGX_IS_SETTINGS (self), KGX_THEME_HACKER);
 
-  if (G_LIKELY (self->theme != KGX_THEME_AUTO)) {
-    return self->theme;
-  }
-
-  if (adw_style_manager_get_dark (manager)) {
-    return KGX_THEME_NIGHT;
-  }
-
-  return KGX_THEME_DAY;
+  return kgx_settings_resolve_theme (self,
+                                     adw_style_manager_get_dark (manager));
 }
 
 
@@ -869,3 +862,28 @@ kgx_settings_set_livery (KgxSettings *restrict self,
     g_object_notify_by_pspec (G_OBJECT (self), pspecs[PROP_LIVERY]);
   }
 }
+
+
+/**
+ * kgx_settings_get_resolved_theme:
+ * @self: the #KgxSettings
+ * @dark_environment: if the environment is dark
+ *
+ * Unlike #KgxSettings:theme this is never %KGX_THEME_AUTO, instead providing
+ * the value %KGX_THEME_AUTO should be treated as
+ */
+KgxTheme
+kgx_settings_resolve_theme (KgxSettings *self, gboolean dark_environment)
+{
+  g_return_val_if_fail (KGX_IS_SETTINGS (self), KGX_THEME_HACKER);
+
+  if (G_LIKELY (self->theme != KGX_THEME_AUTO)) {
+    return self->theme;
+  }
+
+  if (dark_environment) {
+    return KGX_THEME_NIGHT;
+  }
+
+  return KGX_THEME_DAY;
+}
diff --git a/src/kgx-settings.h b/src/kgx-settings.h
index c99b510..130e2e0 100644
--- a/src/kgx-settings.h
+++ b/src/kgx-settings.h
@@ -99,5 +99,7 @@ gboolean              kgx_settings_get_software_flow_control (KgxSettings      *
 KgxLivery            *kgx_settings_get_livery                (KgxSettings           *self);
 void                  kgx_settings_set_livery                (KgxSettings           *self,
                                                               KgxLivery             *livery);
+KgxTheme              kgx_settings_resolve_theme             (KgxSettings           *self,
+                                                              gboolean               dark_environment);
 
 G_END_DECLS
