From: Zander Brown <zbrown@gnome.org>
Date: Mon, 11 Nov 2024 18:07:04 +0000
Subject: window: ensure types referenced in xml

(cherry picked from commit 46c2f668efea61a3115e7cfae7f041fc2c28be3b)

Origin: upstream, future 48 alpha
---
 src/kgx-window.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/kgx-window.c b/src/kgx-window.c
index 02f1693..eb9f26f 100644
--- a/src/kgx-window.c
+++ b/src/kgx-window.c
@@ -614,6 +614,9 @@ kgx_window_class_init (KgxWindowClass *klass)
                                             "win.find",
                                             "search-mode-enabled");
 
+  g_type_ensure (KGX_TYPE_PAGES);
+  g_type_ensure (KGX_TYPE_THEME_SWITCHER);
+
   gtk_widget_class_set_template_from_resource (widget_class,
                                                KGX_APPLICATION_PATH "kgx-window.ui");
 
@@ -701,8 +704,6 @@ kgx_window_init (KgxWindow *self)
   g_autoptr (GtkWindowGroup) group = NULL;
   AdwStyleManager *style_manager;
 
-  g_type_ensure (KGX_TYPE_THEME_SWITCHER);
-
   gtk_widget_init_template (GTK_WIDGET (self));
 
   style_manager = adw_style_manager_get_default ();
