+#pragma once
+
+#include <adwaita.h>
+
+G_BEGIN_DECLS
+
+
+G_GNUC_UNUSED
+static AdwStyleManager *
+kgx_style_manager_for_display (G_GNUC_UNUSED GObject *self,
+                               GdkDisplay            *display)
+{
+  if (G_UNLIKELY (!display)) {
+    return NULL;
+  }
+
+  return g_object_ref (adw_style_manager_get_for_display (display));
+}
+
+G_END_DECLS
